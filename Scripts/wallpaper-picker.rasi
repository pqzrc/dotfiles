* {
    font: "sans 11";
    background-color: #000000;
    text-color: #ffffff;
}
window {
    width: 640px;
    location: center;
    border: 1px;
    border-color: #262626;
    border-radius: 14px;
    padding: 16px;
}
mainbox { children: [ inputbar, listview ]; spacing: 14px; }
inputbar { children: [ prompt, entry ]; spacing: 12px; padding: 8px; }
prompt { text-color: #b0b0b0; }
entry { placeholder: "Search wallpapers…"; }
listview { columns: 3; lines: 2; spacing: 10px; fixed-height: true; }
element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    padding: 8px;
    spacing: 8px;
    border-radius: 8px;
}
element selected.normal { background-color: #1a1a1a; }
element-icon { size: 160px; horizontal-align: 0.5; background-color: transparent; }
element-text { horizontal-align: 0.5; background-color: transparent; }
