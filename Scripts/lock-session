#!/usr/bin/env bash
set -euo pipefail
case "${1:-lock}" in
    lock|suspend) ;;
    *) echo 'Usage: lock-session [lock|suspend]' >&2; exit 2 ;;
esac
command -v swaylock >/dev/null || { notify-send -u critical 'Cannot lock' 'Install swaylock before suspending.'; exit 1; }
# -f returns once the compositor has accepted the lock. Serialize requests.
exec 9>"${XDG_RUNTIME_DIR:?}/rice-lock-request"
flock 9
if ! pgrep -u "$UID" -x swaylock >/dev/null; then
    wallpaper_dir="$HOME/Pictures/Wallpapers"
    wallpaper=''
    if [[ -d $wallpaper_dir ]] && IFS= read -r -d '' wallpaper < <(
        find -H "$wallpaper_dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print0 2>/dev/null | shuf -z -n 1
    ); then
        # A missing or unreadable image must not prevent the session from locking.
        swaylock -f --image "$wallpaper" --scaling fill 9>&- || swaylock -f 9>&-
    else
        swaylock -f 9>&-
    fi
fi
flock -u 9
if [[ ${1:-lock} == suspend ]]; then
    systemctl suspend
fi
