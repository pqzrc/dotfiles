#!/bin/bash

WALLPAPER_DIR="$HOME/Pictures/Wallpapers/"
QUIET=false

if [[ "${2:-}" == "--quiet" ]]; then
	QUIET=true
fi

notify() {
	[[ "$QUIET" == true ]] && return
	notify-send "$@" 2>/dev/null || true
}

set_wallpaper() {
	local wallpaper="$1"

	[[ -z "$wallpaper" ]] && exit 1
	pkill swaybg 2>/dev/null
	swaybg -i "$wallpaper" -m fill &
	notify "Wallpaper" "$(basename "$wallpaper")"
}

choose_with_yazi() {
	local chooser_file yazi_config
	chooser_file=$(mktemp)
	yazi_config=$(mktemp -d)

	cat >"$yazi_config/yazi.toml" <<'EOF'
[manager]
show_hidden = false
sort_by = "natural"

[preview]
image_delay = 0
image_filter = "lanczos3"
image_quality = 90
max_width = 1920
max_height = 1080
EOF

	YAZI_CONFIG_HOME="$yazi_config" yazi --chooser-file "$chooser_file" "$WALLPAPER_DIR"
	wallpaper=$(head -n 1 "$chooser_file")
	rm -f "$chooser_file"
	rm -rf "$yazi_config"

	[[ -z "$wallpaper" ]] && exit 0
	set_wallpaper "$wallpaper"
}

case "${1:-}" in
random)
	[[ ! -d "$WALLPAPER_DIR" ]] && exit 0
	wallpaper=$(find "$WALLPAPER_DIR" -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \) | shuf -n 1)
	set_wallpaper "$wallpaper"
	;;
choose)
	[[ ! -d "$WALLPAPER_DIR" ]] && exit 0
	if command -v rofi >/dev/null; then
		mapfile -d '' -t wallpapers < <(find "$WALLPAPER_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print0 | sort -z)
		[[ ${#wallpapers[@]} -eq 0 ]] && exit 0
		selection=$(
			for wallpaper in "${wallpapers[@]}"; do
				name=$(basename "$wallpaper")
				name=${name//$'\n'/ }
				printf '%s\0icon\x1f%s\n' "$name" "$wallpaper"
			done | rofi -dmenu -no-config -show-icons -p Wallpaper -format i \
				-theme "$(dirname "$(readlink -f "$0")")/wallpaper-picker.rasi"
		) || exit 0
		[[ "$selection" =~ ^[0-9]+$ ]] || exit 0
		set_wallpaper "${wallpapers[$selection]}"
		exit 0
	fi
	if command -v yazi >/dev/null && command -v kitty >/dev/null && [[ ! -t 0 ]]; then
		kitty -e "$0" choose-yazi
		exit 0
	fi

	selection=$(find "$WALLPAPER_DIR" -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \) -printf "%f\n" | sort | fuzzel --dmenu --prompt="Wallpaper: ")
	[[ -z "$selection" ]] && exit 0
	wallpaper=$(find "$WALLPAPER_DIR" -name "$selection" -type f | head -1)
	set_wallpaper "$wallpaper"
	;;
choose-yazi)
	[[ ! -d "$WALLPAPER_DIR" ]] && exit 0
	choose_with_yazi
	;;
esac
