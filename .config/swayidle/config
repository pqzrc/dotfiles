# swayidle configuration file
# Idle timeout events for Sway

# Lock screen after x minutes  of inactivity
timeout 600 '~/Scripts/lock-session'

# Screen off after X  minutes  of inactivity
timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'

# Lock session before sleep
before-sleep '~/Scripts/lock-session'
lock '~/Scripts/lock-session'
