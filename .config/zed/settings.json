{
  "helix_mode": false,
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
  },
  "preferred_line_length": 30,
  "show_wrap_guides": true,
  "relative_line_numbers": "disabled",

  "agent_ui_font_size": 11.0,
  "project_panel": {
    "entry_spacing": "standard",
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never"
    },
    "indent_size": 11.0,
    "default_width": 240.0,
    "hide_hidden": false,
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "cli_default_open_behavior": "existing_window",
  "icon_theme": "Catppuccin Latte",
  "show_edit_predictions": false,
  "languages": {
    "YAML": {
      "show_edit_predictions": false,
    },
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "openai",
      "model": "GPT-5.5",
    },
  },
  "theme": "Zedokai Darker (Filter Spectrum)",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  // UI
  "ui_font_size": 14.0,
  "ui_font_family": "Roboto Mono",
  // Editor
  "buffer_font_size": 11.0,
  "buffer_font_family": "Roboto Mono",
  "buffer_font_features": {
    "calt": false,
  },
  "toolbar": {
    // Whether to show breadcrumbs.
    "breadcrumbs": true,
    // Whether to show quick action buttons.
    "quick_actions": false,
    // Whether to show the Selections menu in the editor toolbar
    "selections_menu": false,
  },
  "tabs": {
    "git_status": true,
  },
  // Other
  "confirm_quit": true,
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [
      ".env",
    ],
  },
  "current_line_highlight": "all",
  "outline_panel": {
    "dock": "left",
    "button": false,
  },
  "notification_panel": {
    // Whether to show the notification panel button in the status bar.
    "button": false,
  },
  "soft_wrap": "editor_width",
  "terminal": {
    // "button": true,
    "font_size": 11.0,
    "copy_on_select": true,
    "blinking": "on",
    "font_family": "Roboto Mono",
    "cursor_shape": "bar",
    "shell": {
      "program": "zsh",
    },
  },
  "collaboration_panel": {
    "button": false,
  },
  "format_on_save": "on",
  "formatter": "prettier",
  "prettier": {
    "semi": false,
    "allowed": true,
    "tabWidth": 2,
    "bracketSpacing": true,
    "jsxSingleQuote": true,
    "singleQuote": true,
  },
}
